---
import Lab from '../layouts/Lab.astro';

const pillars = [
  {
    id: 'intelligence', code: '01', name: 'Intelligence', color: '#c6fb72',
    summary: 'Pesquisa, notícias e leituras de mercado com fontes e contexto.',
    links: [
      ['Observatório', '/observatorio/'],
      ['Vértice Drops', '/drops/'],
      ['Radar IA + Cripto', '/radar-ia-cripto/'],
    ],
  },
  {
    id: 'business', code: '02', name: 'Business', color: '#82e9c6',
    summary: 'Diagnósticos de vendas e ferramentas para organizar operações.',
    links: [
      ['Raio-X de Vendas', '/raio-x-vendas/'],
      ['Implantação comercial', '/solucoes/'],
      ['Núcleo N1', '/n1/'],
    ],
  },
  {
    id: 'creative', code: '03', name: 'Creative', color: '#e4aef5',
    summary: 'Análise visual, portfólio de criativos e experimentos interativos.',
    links: [
      ['Análise visual · N1 Visão', '/n1/visao/fotos/'],
      ['Portfólio e criativos', '/klein/'],
      ['Astro Lab · Mapa natal', '/horoscopo/'],
    ],
  },
  {
    id: 'engineering', code: '04', name: 'Engineering', color: '#f6c580',
    summary: 'Ferramentas técnicas, simulações e experimentos de bancada.',
    links: [
      ['Bancada de Mecatrônica', '/estudos/mecatronica/'],
      ['Triagem pré-dyno', '/tuning/'],
      ['OPSEC Lab', '/privacy/'],
      ['Duelo: Bot vs Hold', '/duelo-bot/'],
      ['Perps Lab', '/perps/'],
    ],
  },
];
---
<Lab home title="Vértice Labs / Research" description="Laboratório independente de pesquisa, diagnóstico comercial, análise visual e engenharia.">
  <main id="conteudo" class="frame">
    <section class="hero grid items-center gap-6 lg:grid-cols-[1.25fr_1fr]" aria-labelledby="titulo">
      <div class="relative z-10">
        <p class="eyebrow"><span aria-hidden="true">/</span> RESEARCH</p>
        <h1 id="titulo">Investigue.<br />Analise.<br /><em>Execute.</em></h1>
        <p class="intro">Pesquisa aplicada e ferramentas para investigar problemas reais.</p>
        <div class="flex flex-wrap gap-3">
          <a class="button primary" href="#pilares">Explorar o laboratório</a>
          <a class="button" href="/observatorio/">Ler o Observatório</a>
        </div>
      </div>
      <div class="lab-grid" aria-hidden="true">
        <div class="grid-center">
          <div class="orbit orbit-outer"></div>
          <div class="orbit orbit-middle"></div>
          <div class="orbit orbit-inner"></div>
          <div class="vertex vertex-left"></div>
          <div class="vertex vertex-right"></div>
        </div>
        <div class="point point-top"></div>
        <div class="point point-right"></div>
        <div class="point point-bottom"></div>
      </div>
    </section>

    <section id="pilares" class="pillars" aria-labelledby="pilares-titulo">
      <div class="section-bar flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <h2 id="pilares-titulo">Pilares do laboratório</h2>
        <nav aria-label="Pilares" class="pillar-nav flex flex-wrap gap-3">
          {pillars.map(({ id, code, name }) => <a href={'#' + id} aria-label={name}>{code}</a>)}
        </nav>
      </div>
      <div class="pillar-grid grid md:grid-cols-2">
        {pillars.map(({ id, code, name, color, summary, links }) => (
          <section class="pillar" id={id} aria-labelledby={id + '-title'} style={{ '--pillar-accent': color }}>
            <div class="pillar-heading flex items-baseline gap-4">
              <span class="pillar-code">{code}</span>
              <h3 id={id + '-title'}>{name}</h3>
            </div>
            <p>{summary}</p>
            <ul>
              {links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
            </ul>
          </section>
        ))}
      </div>
    </section>
  </main>
</Lab>

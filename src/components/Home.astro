---
import AiEntry from './AiEntry';
import Lab from '../layouts/Lab.astro';
const { lang = 'en' } = Astro.props;
const en = lang === 'en';
const observatory = en ? '/en/observatory/' : '/observatorio/';

const pillars = [
  {
    id: 'intelligence', icon: 'M3 19V5m0 14h18M6 14l4-5 4 2 6-7', name: en ? 'Intelligence' : 'Inteligência',
    summary: (en ? "Research, news and market analysis with sources and context." : "Pesquisa, notícias e leituras de mercado com fontes e contexto."),
    links: [
      [(en ? "Observatory" : "Observatório"), observatory],
      [en ? 'Vértice Drops (PT)' : 'Vértice Drops', '/drops/'],
      [(en ? "AI + Crypto Radar (PT)" : "Radar IA + Cripto"), '/radar-ia-cripto/'],
    ],
  },
  {
    id: 'business', icon: 'M3 8h18v12H3zM8 8V5h8v3M3 12l9 3 9-3', name: en ? 'Business' : 'Negócios',
    summary: (en ? "Sales diagnostics and tools for organizing operations." : "Diagnósticos de vendas e ferramentas para organizar operações."),
    links: [
      [(en ? "Sales Diagnostics (PT)" : "Raio-X de Vendas"), '/raio-x-vendas/'],
      [(en ? "Business Implementation (PT)" : "Implantação comercial"), '/solucoes/'],
      [(en ? "N1 Core (PT)" : "Núcleo N1"), '/n1/'],
    ],
  },
  {
    id: 'creative', icon: 'M4 5h16v14H4zM4 16l5-5 4 4 3-3 4 4M15 8h2', name: en ? 'Creative' : 'Criação',
    summary: (en ? "Visual analysis, creative portfolio and interactive experiments." : "Análise visual, portfólio de criativos e experimentos interativos."),
    links: [
      [(en ? "Visual Analysis · N1 Vision (PT)" : "Análise visual · N1 Visão"), '/n1/visao/fotos/'],
      [(en ? "Portfolio & Creative (PT)" : "Portfólio e criativos"), '/klein/'],
    ],
  },
  {
    id: 'engineering', icon: 'M8 7h8v10H8zM5 9h3m-3 5h3m8-5h3m-3 5h3M10 4v3m4-3v3m-4 10v3m4-3v3', name: en ? 'Engineering' : 'Engenharia',
    summary: (en ? "Technical tools, simulations and laboratory experiments." : "Ferramentas técnicas, simulações e experimentos de bancada."),
    links: [
      [(en ? "Mechatronics Bench (PT)" : "Bancada de Mecatrônica"), '/estudos/mecatronica/'],
      [(en ? "Pre-dyno Assessment (PT)" : "Triagem pré-dyno"), '/tuning/'],
      [en ? 'OPSEC Lab (PT)' : 'OPSEC Lab', '/privacy/'],
    ],
  },
];

// Project a ridge surface into a stack of contour profiles for the atlas cover.
const ridges = Array.from({ length: 40 }, (_, row) => {
  const y = row / 39;
  const points = Array.from({ length: 101 }, (_, column) => {
    const x = column / 100;
    const crest = .57 + .13 * Math.sin(y * 4);
    const peak = Math.exp(-Math.pow((x - crest) / .17, 2));
    const spur = Math.exp(-Math.pow((x - .32 - y * .09) / .13, 2));
    const height = (peak * 148 + spur * 62) * (.54 + .46 * Math.sin(y * Math.PI));
    const folds = (7 * Math.sin(x * 69 + y * 7) + 4 * Math.sin(x * 123 - y * 4)) * peak;
    return `${column === 0 ? 'M' : 'L'}${column * 6},${(116 + y * 214 - height + folds).toFixed(1)}`;
  });
  return points.join(' ') + ' V340 H0 Z';
});

const highlights = [
  { label: en ? 'Business' : 'Negócios', title: en ? 'I sell through WhatsApp.' : 'Vendo pelo WhatsApp.', detail: en ? 'Find gaps in follow-up and organize your sales process.' : 'Identifique falhas no atendimento e organize seu processo comercial.', href: '/solucoes/', link: en ? 'Explore implementation (PT)' : 'Conhecer a implantação', icon: '01' },
  { label: en ? 'Research' : 'Pesquisa', title: en ? 'I follow technology.' : 'Acompanho tecnologia.', detail: en ? 'Verified technology news, sources and practical implications.' : 'Notícias de tecnologia verificadas, fontes e impactos práticos.', href: observatory, link: en ? 'Read the Observatory' : 'Ler o Observatório', icon: '02' },
  { label: en ? 'Engineering' : 'Engenharia', title: en ? 'Explore technical problems.' : 'Explore problemas técnicos.', detail: en ? 'Interactive tools, diagnostics and engineering studies.' : 'Ferramentas interativas, diagnósticos e estudos de engenharia.', href: '/en/', link: en ? 'Explore engineering' : 'Explorar engenharia (EN)', icon: '03' },
];
---
<Lab home lang={lang} title="Vértice Labs — Research & tools" description={en ? "Independent laboratory for research, business diagnostics, visual analysis and engineering." : "Laboratório independente de pesquisa, diagnóstico comercial, análise visual e engenharia."}>
  <main id="conteudo" class="frame product-home">
    <section data-catalog-hero class="atlas-cover" aria-labelledby="titulo">
      <svg class="relief" viewBox="0 0 600 320" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
        {ridges.map(path => <path d={path} />)}
      </svg>
      <div class="cover-type">
        <h1 id="titulo">{en ? 'Lab' : 'Atlas do'}<br /><em>{en ? 'atlas' : 'laboratório'}</em></h1>
        <p>{en ? 'Tools, field notes and experiments from Vértice Labs.' : 'Ferramentas, notas de campo e experimentos da Vértice Labs.'}</p>
      </div>
    </section>
    <section id="pilares" class="pillars product-catalog" aria-labelledby="pilares-titulo">
      <div class="section-bar"><h2 id="pilares-titulo">{en ? 'Browse by field' : 'Explore por área'}</h2></div>
      <div class="resource-list">
        {pillars.map(({ id, icon, name, summary, links }) => (
          <details id={id} class="resource-group">
            <summary>
              <svg aria-hidden="true" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"><path d={icon} /></svg>
              <strong>{name}</strong>
              <span class="resource-count">{links.length} {en ? 'resources' : 'recursos'}</span>
              <span class="disclosure-arrow" aria-hidden="true"></span>
            </summary>
            <div class="resource-content">
              <p>{summary}</p>
              <ul>{links.map(([label, href]) => <li><a href={href}>{label}<span aria-hidden="true">↗</span></a></li>)}</ul>
            </div>
          </details>
        ))}
      </div>
      <a class="directory-action" href="/pt/catalogo/">{en ? 'View classic catalog (PT)' : 'Ver catálogo clássico'}</a>
    </section>
    <div class="workbench">
        <div class="finder">
          <p>{en ? 'What are you working on?' : 'Em que você está trabalhando?'}</p>
          <AiEntry client:visible><div class="ai-entry" data-ai-entry="intent"></div></AiEntry>
        </div>
      <aside class="diagnosis-preview" aria-labelledby="example-title">
        <span class="example-tag">{en ? 'ILLUSTRATIVE DATA' : 'DADOS FICTÍCIOS'}</span>
        <h2 id="example-title">{en ? 'Sales diagnostic · example' : 'Raio-X de Vendas · exemplo'}</h2>
        <dl>
          <div><dt>{en ? 'Monthly inquiries' : 'Leads por mês'}</dt><dd>200</dd></div>
          <div><dt>{en ? 'Unanswered inquiries' : 'Leads sem resposta'}</dt><dd>60</dd></div>
          <div><dt>{en ? 'Assumed conversion' : 'Conversão assumida'}</dt><dd>8%</dd></div>
          <div><dt>{en ? 'Average sale / contribution margin' : 'Ticket médio / margem de contribuição'}</dt><dd>{en ? 'R$1,200 / 40%' : 'R$ 1.200 / 40%'}</dd></div>
        </dl>
        <div class="example-output"><span>{en ? 'Potential monthly contribution' : 'Possível recuperação mensal'}</span><strong>{en ? 'R$2,304' : 'R$ 2.304'}</strong></div>
        <p>{en ? 'Illustrative estimate, not observed revenue. Recovery and conversion are not guaranteed.' : 'Estimativa ilustrativa, não receita observada. Recuperação e conversão não são garantidas.'}</p>
        <a href="/raio-x-vendas/">{en ? 'Calculate with your data (PT)' : 'Calcular com meus dados'} ↗</a>
      </aside>
    </div>
    <section class="workspace-body editorial-highlights" aria-labelledby="highlights-title">
      <div class="section-bar"><h2 id="highlights-title">{en ? 'Start with a real problem' : 'Comece por um problema real'}</h2></div>
      <div class="highlight-grid">{highlights.map(item => <article class="highlight"><span class="highlight-label">{item.label}</span><h3>{item.title}</h3><p>{item.detail}</p><a href={item.href}>{item.link} <span aria-hidden="true">↗</span></a></article>)}</div>
    </section>

    <section class="experiments" aria-labelledby="experiments-title">
      <div class="section-bar"><h2 id="experiments-title">{en ? 'Experiments' : 'Experimentos'}</h2></div>
      <p>{en ? 'Independent simulations and exploratory projects.' : 'Simulações independentes e projetos exploratórios.'}</p>
      <div class="experiment-links">
        <a href="/duelo-bot/">{en ? 'Duel: Bot vs Hold (PT)' : 'Duelo: Bot vs Hold'}</a>
        <a href="/perps/">{en ? 'Perps Lab (PT)' : 'Perps Lab'}</a>
        <a href="/horoscopo/">{en ? 'Astro Lab · Birth Chart (PT)' : 'Astro Lab · Mapa natal'}</a>
      </div>
    </section>
  </main>
</Lab>

<style>
  .product-home { --mint:var(--lab-accent); --soft:#aeb8b1; --edge:#303a35; --surface:#191e1b; }
  .atlas-cover { isolation:isolate; position:relative; overflow:hidden; display:flex; align-items:flex-end; min-height:clamp(17rem,29vw,25rem); margin-block:1rem 2rem; padding:clamp(1.2rem,4vw,3.5rem); background:#151914; color:#faf8ed; border-block:1px solid var(--edge); }
  .relief { position:absolute; z-index:-1; right:0; bottom:0; width:67%; height:100%; }
  .relief path { fill:#111610; stroke:#c4df79; stroke-width:1; }
  .cover-type { max-width:53%; }
  .atlas-cover h1 { color:inherit; font:650 clamp(3.2rem,7vw,6.5rem)/.88 var(--lab-sans); letter-spacing:-.075em; margin:0; }
  .atlas-cover h1 em { font-family:Georgia,serif; font-weight:400; letter-spacing:-.07em; }
  .cover-type p { font-size:1rem; line-height:1.45; max-width:33ch; margin:1.15rem 0 0; }
  .workbench { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:clamp(1rem,4vw,3rem); align-items:start; margin-bottom:3rem; }
  .product-catalog { scroll-margin-top:5rem; }
  .finder { max-width:42rem; margin:1.6rem 0 0; text-align:left; }
  .finder > p { font-size:.85rem; color:var(--soft); }
  .finder :global(.ai-entry) { background:#1c221e; border:1px solid #414d45; border-radius:var(--vl-radius-panel); padding:.8rem; margin:.55rem 0 0; font:.95rem/1.5 var(--lab-sans); }
  .finder :global(.ai-entry textarea) { color:#ecf0ec; background:transparent; border:0; border-radius:.6rem; padding:.8rem; min-height:50px; }
  .finder :global(.ai-entry button),.finder :global(.ai-entry a) { justify-self:start; min-height:44px; border-radius:var(--vl-radius-control); border:1px solid #506354; background:#293c2d; color:var(--mint); padding:.6rem 1rem; }
  .editorial-highlights { padding-block:1rem 3.5rem; }
  .section-bar { display:flex; justify-content:space-between; align-items:baseline; gap:1rem; flex-wrap:wrap; border-color:var(--edge); font-family:inherit; }
  .section-bar h2 { font:650 clamp(1.5rem,3vw,2.15rem)/1.2 var(--lab-sans); letter-spacing:-.045em; }
  .section-bar .eyebrow { margin:0 0 .5rem; }
  .highlight-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; }
  .highlight { display:flex; flex-direction:column; align-items:flex-start; min-width:0; background:var(--surface); border:1px solid var(--edge); border-radius:var(--vl-radius-panel); padding:clamp(1.25rem,3vw,2rem); }
  .highlight-label { color:var(--mint); font-size:.83rem; }
  .highlight h3 { font-size:clamp(1.3rem,2.4vw,1.9rem); font-weight:650; line-height:1.15; letter-spacing:-.04em; margin:1.1rem 0 .65rem; }
  .highlight p { color:var(--soft); line-height:1.6; margin-bottom:1.5rem; }
  .highlight a { color:var(--mint); margin-top:auto; min-height:44px; display:inline-flex; gap:.5rem; align-items:center; font-weight:600; font-size:.9rem; }
  .resource-list { display:grid; gap:.75rem; }
  .resource-group { border:1px solid var(--edge); border-radius:var(--vl-radius-panel); background:var(--surface); }
  .resource-group[open] { border-color:var(--mint); }
  .resource-group summary { display:grid; grid-template-columns:auto minmax(0,1fr) auto auto; align-items:center; gap:clamp(.5rem,2vw,1.25rem); padding:1rem; min-height:4rem; cursor:pointer; list-style:none; }
  .resource-group summary::-webkit-details-marker { display:none; }
  .resource-group svg,.disclosure-arrow { color:var(--mint); }
  .resource-group summary svg { padding:.4rem; box-sizing:content-box; background:#25311e; border-radius:.4rem; }
  .resource-group strong { font:600 clamp(1.05rem,2vw,1.5rem)/1.15 var(--lab-sans); letter-spacing:-.035em; }
  .resource-count { color:var(--soft); font:500 .8rem var(--lab-mono); }
  .disclosure-arrow { width:.5rem; height:.5rem; border:solid currentColor; border-width:1.5px 1.5px 0 0; transform:rotate(45deg); }
  .resource-group[open] .disclosure-arrow { transform:rotate(135deg); }
  .resource-content { border-top:1px solid var(--edge); padding:.75rem 1rem; }
  .resource-content p { color:var(--soft); line-height:1.5; }
  .resource-content ul { padding:0; list-style:none; }
  .resource-content a,.directory-action { display:flex; align-items:center; min-height:44px; color:var(--mint); }
  .resource-content a { justify-content:space-between; gap:.75rem; }
  .directory-action { justify-content:center; border:1px solid var(--mint); border-radius:var(--vl-radius-control); margin-top:1rem; text-align:center; }
  .product-catalog :focus-visible { outline:2px solid var(--mint); outline-offset:2px; }
  @media (prefers-reduced-motion:no-preference) { .disclosure-arrow { transition:transform .16s ease; } }
  @media (max-width:360px) { .resource-group summary { grid-template-columns:auto minmax(0,1fr) auto; } .resource-count { grid-column:2; } .disclosure-arrow { grid-column:3; grid-row:1 / span 2; } }
  @media(max-width:760px) {
    .highlight-grid,.workbench { grid-template-columns:minmax(0,1fr); }
    .atlas-cover { margin-top:.6rem; min-height:16rem; padding:1.25rem; align-items:flex-end; }
    .relief { width:100%; height:88%; bottom:auto; top:-7%; right:-18%; opacity:.84; }
    .cover-type { max-width:100%; }
    .cover-type h1 { font-size:clamp(3.15rem,13vw,5.3rem); text-shadow:0 2px 8px #111610; }
    .cover-type p { max-width:29ch; margin-top:.8rem; }
  }
  @media(prefers-reduced-motion:no-preference) { .highlight { transition:border-color .18s ease,transform .18s ease; } .highlight:hover { border-color:var(--mint); transform:translateY(-2px); } }
  .diagnosis-preview { min-width:0; border:1px solid var(--edge); border-radius:var(--vl-radius-panel); background:var(--surface); padding:clamp(1rem,3vw,2rem); align-self:start; }
  .example-tag { display:inline-block; color:var(--mint); font:500 .73rem/1.4 var(--lab-mono); letter-spacing:.08em; }
  .diagnosis-preview h2 { font-size:clamp(1.3rem,2.5vw,1.7rem); margin:1rem 0; letter-spacing:-.04em; }
  .diagnosis-preview dl { margin:0; font-size:.875rem; }
  .diagnosis-preview dl div { display:flex; gap:.75rem; justify-content:space-between; align-items:baseline; padding:.6rem 0; border-top:1px solid var(--edge); }
  .diagnosis-preview dt { color:var(--soft); }
  .diagnosis-preview dd { margin:0; font-family:var(--lab-mono); text-align:right; white-space:nowrap; }
  .example-output { border-top:1px solid var(--edge); padding-top:1rem; margin-top:.5rem; }
  .example-output span { display:block; color:var(--soft); font-size:.85rem; }
  .example-output strong { display:block; color:var(--mint); font:700 clamp(2rem,4vw,3.1rem)/1.15 var(--lab-sans); margin:.4rem 0; }
  .diagnosis-preview p,.experiments p { color:var(--soft); font-size:.9rem; line-height:1.5; }
  .diagnosis-preview a,.experiment-links a { color:var(--mint); display:inline-flex; align-items:center; min-height:44px; text-underline-offset:4px; }
  .experiments { padding-bottom:3rem; }
  .experiment-links { display:flex; flex-wrap:wrap; gap:.5rem 1.5rem; }

</style>

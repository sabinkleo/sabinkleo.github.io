---
import '../styles/lab.css';

const { title, description, home = false, technical = false, privateBrief = false, publicService = false, lang = "pt" } = Astro.props;
const en = lang === "en";
const homePath = en ? "/" : "/pt/";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang={en ? "en" : "pt-BR"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#0c0e0d" />
    <meta name="referrer" content="no-referrer" />
    {privateBrief && <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cpath fill='%23d3fa43' d='M1 4h8l7 15 7-15h8L16 32z'/%3E%3C/svg%3E" />}
    {privateBrief && <meta http-equiv="Content-Security-Policy" content="connect-src 'self'; form-action 'none'; object-src 'none'; base-uri 'self'" />}
    {!privateBrief && <>
    <link rel="stylesheet" href="/assets/command-hud.css" />
    <script is:inline defer src="/assets/command-hud.js"></script>
    {import.meta.env.PUBLIC_CONTACT_EMAIL && <meta name="vl-contact-email" content={import.meta.env.PUBLIC_CONTACT_EMAIL} />}
    </>}
    <title>{title}</title>
    <meta name="description" content={description} />
    {home || technical || publicService ? (
      <>
        <link rel="canonical" href={canonical} />
        {publicService && <><link rel="alternate" hreflang="en" href="https://verticelabs.me/geo/" /><link rel="alternate" hreflang="pt-BR" href="https://verticelabs.me/pt/geo/" /><link rel="alternate" hreflang="x-default" href="https://verticelabs.me/geo/" /></>}
        {home && <>
        <link rel="alternate" hreflang="en" href="https://verticelabs.me/" />
        <link rel="alternate" hreflang="pt-BR" href="https://verticelabs.me/pt/" />
        <link rel="alternate" hreflang="x-default" href="https://verticelabs.me/" />
        </>}
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        {technical && <script is:inline type="application/ld+json" set:html={JSON.stringify({
          '@context': 'https://schema.org', '@type': Astro.url.pathname === '/en/' ? 'CollectionPage' : 'WebPage',
          name: title, description, url: canonical, inLanguage: 'en'
        }).replace(/</g, '\\u003c')} />}
        {!privateBrief && <>
        <link rel="stylesheet" href="/assets/consent.css" />
        <script is:inline defer src="/assets/measurement.js"></script>
        </>}
      </>
    ) : <meta name="robots" content="noindex,nofollow" />}
  </head>
  <body class:list={[{'product-shell':home}]}>
    <a class="skip" href="#conteudo">{en ? "Skip to content" : "Ir para o conteúdo"}</a>
    <header class="top">
      <div class="frame top-inner flex flex-wrap items-center justify-between gap-x-8 gap-y-3">
        <a class="brand" href={homePath} aria-label={en ? "Vértice Labs, home" : "Vértice Labs, início"}><span class="brand-mark" aria-hidden="true"></span> VÉRTICE<span class="accent">{home ? " /" : "."}</span> LABS</a>
        <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label={en ? "Vértice navigation" : "Menu da Vértice"}>
          <a href={home ? '#pilares' : homePath + '#pilares'}>{home ? (en ? "Workspace" : "Ferramentas") : (en ? "Pillars" : "Pilares")}</a>
          <a href="/observatorio/">{en ? "Observatory" : "Observatório"}</a>
          <a href="/solucoes/">{en ? "Solutions" : "Soluções"}</a>
          <a data-attribution={!privateBrief || undefined} href="/en/">{home ? (en ? "Engineering" : "Engenharia") : (en ? "Technical tracks" : "Trilhas técnicas")}</a>
          {!privateBrief && <span data-hud-trigger></span>}
          <span class="flex gap-2" aria-label={en ? "Site languages" : "Idiomas do site"}>
            <a href={publicService ? "/pt/geo/" : "/pt/"} lang="pt-BR" hreflang="pt-BR" aria-current={!en && home ? 'page' : undefined}>PT</a>
            <span aria-hidden="true">/</span>
            <a href={publicService ? '/geo/' : technical ? '/en/' : '/'} lang="en" hreflang="en" aria-current={en && home ? 'page' : undefined}>EN</a>
          </span>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="foot">
      <div class="frame flex flex-wrap items-center justify-between gap-4">
        <span>VÉRTICE LABS · {en ? "INDEPENDENT LABORATORY" : "LABORATÓRIO INDEPENDENTE"}</span>
        <a href="/politica-de-privacidade/">{en ? "Privacy policy" : "Política de privacidade"}</a>
      </div>
    </footer>
  </body>
</html>

<script>
  import { attributedUrl } from '../services/attribution';
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-attribution]')) {
    if (link.getAttribute('href')?.startsWith('/')) link.href = attributedUrl(link.href).href;
  }
</script>
